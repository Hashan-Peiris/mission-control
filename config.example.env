# mission-control settings. Copy to config.env (mctl does this by itself on first run) and fill in your hosts.
# config.env is yours and is never committed; `mctl setup` writes per-machine values to config.<machine>.env.

GOALS="auto"          # auto = every running Codex or Claude session is shown (tmux or not), nothing to configure;
                      # or list tmux session names to watch only those, e.g. GOALS="MY_GOAL OTHER_GOAL"
NODES=""              # compute nodes always watched. Others are found automatically (see AUTO_NODES); add one here only
                      # if your connection script doesn't keep a connection to it. Reached through Rockfish; ROUTE_<node>=direct otherwise
LOGIN_DIGESTS=1       # also show agents running on the Rockfish and Skipjack login nodes themselves
AUTO_NODES=1          # also watch any node your connection script keeps a shared connection to on the Rockfish login node
TMUX_SESSION=""       # optional: a goal to show even while its node is down
RF_HOST="rf"          # ssh alias for Rockfish login (auto-detected)
SAIPH_HOST=""         # (historical name) your main compute node, as reached from Rockfish
SAIPH_ROUTE=""        # nested (ssh rf ssh NODE) or direct (ssh NODE); auto-detected
SJ_HOST=""            # ssh alias for Skipjack (auto-detected)
SCYTHE_HOST=""        # optional GPU box polled with nvidia-smi (auto-detected if an alias contains "scythe")
NEVER_CONTACT=""      # words for hosts mission control must never touch, matched anywhere in an alias, host name or
                      # socket name (any case), e.g. NEVER_CONTACT="labserver1 labserver2"
EXCLUDE_HOSTS=""      # exact ssh aliases never used, on top of NEVER_CONTACT
HOSTS=""              # more machines to watch: "alias", "node@jump" (reached from host jump), "/15" = every 15 min;
                      # e.g. HOSTS="myserver/15 node12@gateway". mctl hosts lists them and the connections you could add
CONNECT_CMD=""        # the alias you run to open your shared SSH connections (shown in "run ..." hints)

PRIMARY_HOST=""       # the always-on PC that collects (its hostname); other machines stand by and take over if it stops
LAUNCH_ROOT=""        # where New session puts new folders (default: the WORK folder your sessions run under)
SJ_TARGET=""          # Skipjack login host name, reached through Rockfish unless this machine has its own connection

INTERVAL_MIN=5        # minutes between collections
HOURS=48              # look-back window for agent logs and Slurm accounting
STALL_MIN=30          # minutes of agent silence before the dashboard calls it quiet (3x = stalled)
LOW_EFF=0.25          # flag finished jobs that used less than this share of their CPUs
PENDING_HOURS=6       # flag jobs pending longer than this

SCAN_ROOTS=""         # extra folders on the compute node to scan for input files, colon-separated (default: the goal's folder)
PARAM_FILES="INCAR,KPOINTS"   # input file names to read watched parameters from
SCAN_HOURS=72         # only input files changed in this window are scanned

NTFY_TOPIC=""         # set to a long random name to get phone pushes via the free ntfy app (e.g. mc-7f3k29xq-r8w2)
NTFY_SERVER="https://ntfy.sh"
DIGEST_HOUR=8         # morning brief push after this local hour

REFEREE_CMD=""        # optional second-model review, e.g.: claude -p   or   codex exec -
REFEREE_EVERY_H=0     # 0 = only when you run `mctl referee`

LOCAL_DIGEST=1        # also summarize Codex/Claude sessions running here in WSL
DISPLAY_TZ="America/New_York"
WEB_SERVER=1          # serve the dashboard at http://localhost:8765 so you can message agents from it (0 = off)
WEB_PORT=8765
HIDE_SECTIONS=""   # blocks hidden on every machine: mctl hide / mctl unhide
